# Set default behavior: normalize all text files to LF on commit and checkout
* text=auto eol=lf

# Godot engine files
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.uid text eol=lf
*.shader text eol=lf
*.gdshader text eol=lf

# Map and TrenchBroom files
*.map text eol=lf
*.fgd text eol=lf
*.cfg text eol=lf

# Text & data files
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.gdignore text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files - preserve exact bytes
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.bmp binary
*.tga binary
*.exr binary
*.hdr binary
*.ico binary
*.blend binary
*.fbx binary
*.obj binary
*.glb binary
*.gltf text eol=lf
*.wav binary
*.ogg binary
*.mp3 binary
*.import binary
*.ttf binary
*.otf binary
*.zip binary
