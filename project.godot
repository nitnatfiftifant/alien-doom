[layer_names]

3d_physics/layer_1="WORLD"
3d_physics/layer_2="CREATURE"
3d_physics/layer_3="HUMAN"
3d_physics/layer_4="INTERACTION"
3d_physics/layer_5="TRIGGER"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.008, 0.012, 0.016, 1)
